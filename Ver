end
applyBladeDura = function()
    restoreBladeDura()
    local accum = 0
    Pins.BladeDura = RunService.Heartbeat:Connect(function(dt)
        -- Throttle to ~2Hz. Durability only drops when a swing LANDS, so re-pinning twice a second
        -- is ample. The old version ran EVERY Heartbeat (~60Hz) over ~24 attribute names × every
        -- tool = hundreds of SetAttribute bridge writes per frame — a major menu-lag source. ~30x less.
        accum = accum + (dt or 0.016)
