    "Uses","UsesLeft","UsesRemaining","Hits","HitsLeft","HitsRemaining",
    "BladeCount","BladesLeft","BladesRemaining","Blades",
    "Charges","MaxCharges","MaxAmount",
    "Wear","Condition",
    "LeftBladeDurability","RightBladeDurability",
}
restoreBladeDura = function()
