-- End key = full unload (the library owns F3 menu-toggle + F4 ESP).
-- RELEASE-ARM GUARD (mirrors Menu.lua's CloseKeyReady): only unload AFTER the close key has
-- been observed RELEASED at least once. Matcha can falsely report VK_END (0x23) as permanently
-- held (an iskeypressed quirk — confirmed 2026-07-02: iskeypressed(0x23) returns true even when
-- End isn't pressed). Without this guard the watcher sees a "press" on frame 1 and instantly
-- calls UnloadScript on the freshly-built menu, so it never renders. Seeding from a released
-- state makes a stuck-true key harmless, while a genuine End press still unloads normally.
task.spawn(function()
    local ready, wasDown = false, false
    while GUI.Running do
        local ok, down = pcall(iskeypressed, GUI.CloseKey or 0x23)
        down = ok and down or false
        if ready then
            if down and not wasDown then pcall(UnloadScript); return end
        elseif not down then
            ready = true
        end
        wasDown = down
        task.wait(0.05)
    end
end)

