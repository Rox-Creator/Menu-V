local function UnloadScript()
    GUI.Running = false
    pcall(function() if GUI.StopEspLoops then GUI.StopEspLoops() end end)
    -- Tear down the INS-ui window (cleanup closure is installed at startup)
    pcall(function() if _G.MatchaCleanup then _G.MatchaCleanup() end end)
    _G.MatchaCleanup = nil
    if Horse.SnapTaken then pcall(restoreHorse) end
    -- Tear down buff Heartbeat pins
    pcall(restoreHookRange)
    pcall(restoreGasConservation)
    pcall(restoreReloadSpeed)
    pcall(restoreOdmVeloCap)
    pcall(restoreRunSpeed)
    -- Tear down anti-titan: force all flags off, clear titan attributes, stop the pin.
    -- ALL hitbox flags must be cleared before refreshAntiTitan, or anyTitanFeatureOn() stays true
    -- and the "restore" pass re-ENABLES the 3Hz loop + ChildAdded hook instead of tearing them down.
    Features.NoGrab = false; Features.NoStomp = false; Features.NoBite = false; Features.NoAttack = false
    Features.NoKick = false; Features.NoPunch = false; Features.NoSwing = false
    pcall(refreshAntiTitan)
    pcall(restoreNapeFollow)
    pcall(restoreMusketExtender)
    pcall(restoreNoAttack)
    pcall(restoreBladeDura)
    pcall(restoreCanRollUnlock)
    pcall(restoreNoFallDamage)
    pcall(restoreAutoPin)
    pcall(restoreHandlesBypass)
    pcall(restoreNeverStops)
    pcall(restoreRunWithSword)
    pcall(restoreVeloHUD)
    for _, el in ipairs(GUI.Elements)        do pcall(function() el:Remove() end) end
    for _, el in ipairs(GUI.ContentElements) do pcall(function() el:Remove() end) end
    for _, el in ipairs(GUI.SubTabElements)  do pcall(function() el:Remove() end) end
    for _, el in ipairs(GUI.RSDiffElements)  do pcall(function() el:Remove() end) end
    for _, el in ipairs(GUI.EnchantsElements) do pcall(function() el:Remove() end) end
    GUI.Elements, GUI.ContentElements, GUI.SubTabElements, GUI.RSDiffElements, GUI.EnchantsElements = {}, {}, {}, {}, {}
    GUI.Clickables, GUI.SubTabClickables, GUI.RSDiffClickables, GUI.EnchantsClickables = {}, {}, {}, {}
