-- One-shot pins (button-driven, no Heartbeat). Apply the current target a single time.
local function pinAttrOnce(attrName, key)
    local ci = LocalPlayer:FindFirstChild("ClientInformation")
    if not ci then return false end
    local b = BuffsState[key]
    if not b then return false end
    return pcall(function() ci:SetAttribute(attrName, b.target) end)
end

-- Every ClientInformation buff the UI exposes. The attribute name IS the BuffsState key, so no
-- name-mapping table is needed. Order only matters for the "Pin All" toast.
local AUTOPIN_KEYS = {
    "HookRange", "GasConservation", "ReloadSpeed", "OdmVeloCap", "RunSpeed",
    "FirearmRange", "OdmHookVeloGain", "OdmPassiveVeloGain", "ActionSpeed",
}

-- Write every buff once. Returns how many landed (0 = not in a round yet).
local function pinAllBuffsOnce()
    local ci = LocalPlayer:FindFirstChild("ClientInformation")
    if not ci then return 0 end
    local n = 0
    for _, key in ipairs(AUTOPIN_KEYS) do
        local b = BuffsState[key]
        if b and pcall(function() ci:SetAttribute(key, b.target) end) then n = n + 1 end
    end
    return n
end

-- AUTO PIN — re-applies every buff on a slow timer so you never have to press Pin again after the
-- server recomputes a stat (respawn, gear swap, buff expiry) or after you edit a number.
-- Deliberately NOT the old build's pin: that connected the same closure to Heartbeat AND
-- RenderStepped "out of phase" and did a GetAttribute read before every write — ~2400 bridge
-- round-trips/sec with all buffs on, which is what froze the menu. This is one accumulator at
-- AutoPinEvery seconds (default 3) => ~3 writes/sec total, and it costs literally nothing while
-- the toggle is off because the cheapest guard runs first.
restoreAutoPin = function()
    if Pins.AutoPin then Pins.AutoPin:Disconnect(); Pins.AutoPin = nil end
end
applyAutoPin = function()
    restoreAutoPin()
    local accum = 0
    -- fire one immediately so the toggle has a visible effect without waiting a full interval
    pcall(pinAllBuffsOnce)
    Pins.AutoPin = RunService.Heartbeat:Connect(function(dt)
        if not Features.AutoPin then return end          -- cheapest guard first
        accum = accum + (dt or 0.016)
        if accum < (AutoPinEvery or 3) then return end
        accum = 0
        pcall(pinAllBuffsOnce)
    end)
end

-- HANDLES BYPASS — pin HandlesBypass/ProtoHandlesBypass so weapons work without the normal
-- "handles" requirement. The old build wrote BOTH attributes on EVERY child of Character and
-- Backpack at 20Hz — in AoT that is all R15 limbs, Humanoid, HumanoidRootPart, Animate and every
-- accessory (~50 pointless writes per tick, the most expensive feature in that file). Here we
-- filter to :IsA("Tool") (~4 targets, which was plainly the intent) and re-assert at 2Hz, so it
-- survives tool swaps and server pushes for ~8 writes/sec instead of ~1000.
-- Shared by apply + restore so turning the toggle off actually CLEARS the flags instead of just
-- stopping the loop (the file's restore* convention: disconnect AND undo the write).
-- `IsA("Tool") == true` is deliberate: Matcha's IsA can return a truthy non-boolean, and a plain
-- truthy test would fail OPEN and write to all ~26 Character children — the old build's flood.
local function handlesBypassWrite(on)
    local function doBag(bag)
        if not bag then return end
        for _, t in ipairs(bag:GetChildren()) do
            if t:IsA("Tool") == true then
                pcall(function() t:SetAttribute("HandlesBypass", on) end)
                pcall(function() t:SetAttribute("ProtoHandlesBypass", on) end)
            end
        end
    end
    doBag(LocalPlayer.Character)
    doBag(LocalPlayer:FindFirstChild("Backpack"))
end

restoreHandlesBypass = function()
    if Pins.HandlesBypass then Pins.HandlesBypass:Disconnect(); Pins.HandlesBypass = nil end
    pcall(handlesBypassWrite, false)
end
applyHandlesBypass = function()
    restoreHandlesBypass()
    local accum = 0
    pcall(handlesBypassWrite, true)
    Pins.HandlesBypass = RunService.Heartbeat:Connect(function(dt)
        if not Features.HandlesBypass then return end
        accum = accum + (dt or 0.016)
        if accum < 0.5 then return end                   -- 2Hz, house cadence for attribute pins
        accum = 0
        pcall(handlesBypassWrite, true)
    end)
end


-- Drive ONE weakpoint part to "big" (a cube at you) or "tiny", writing the static properties ONLY
-- on the state transition. This is the single biggest write saving in the file: the old version
-- re-wrote Anchored, CanCollide, CanQuery, CanTouch, Massless, AssemblyLinearVelocity, Size, CFrame,
-- Transparency, LocalTransparencyModifier AND walked GetChildren to disable joints — about 15 bridge
-- writes per part, per titan, on EVERY tick of the swing window. All of those are idempotent; only
-- the CFrame actually has to change as the titan walks. So the steady-state cost is now ONE write.
local EXPAND_MAX = 8   -- nearest N titans get the expander (a swing can only reach one anyway)

local function napeSetState(e, p, addr, stKey, szKey, want, size, target)
    if not p then return end
    if e[stKey] ~= want then
        -- Snapshot ONCE, before the very first modification, keyed by ADDRESS (an instance key
        -- would miss on every later pass and end up recording the already-blown-up cube as the
        -- "original"). Transparency/Massless are captured too, or napes stay permanently invisible
        -- after the expander is switched off.
        if addr and not Pins.NapeOriginals[addr] then
            local ok, snap = pcall(function()
                return { part = p, size = p.Size, transparency = p.Transparency, massless = p.Massless }
            end)
            if ok and snap then Pins.NapeOriginals[addr] = snap end
        end
        e[stKey] = want
        e[szKey] = nil     -- force the Size write below for the new state
        if want == "big" then
            -- CanQuery=true so the nape intercepts the swing's raycast — otherwise the ray passes
            -- through and the LEG behind it steals the hit.
            pcall(function() p.Anchored = true end)
            pcall(function() p.CanCollide = false end)
            pcall(function() p.CanQuery = true end)
            pcall(function() p.CanTouch = true end)
            pcall(function() p.Massless = true end)
            pcall(function() p.Transparency = 1 end)
            pcall(function() p.LocalTransparencyModifier = 1 end)
            for _, j in ipairs(p:GetChildren()) do
                if j:IsA("WeldConstraint") or j:IsA("Weld") or j:IsA("Motor6D") then
                    pcall(function() j.Enabled = false end)
                end
            end
        else
            -- Idle: tiny, so there's no big part in your horse's path (a huge cube stops the horse
            -- regardless of the collide/query/touch flags).
            pcall(function() p.CanTouch = false end)
        end
    end
    local wantSize = (want == "big") and size or 0.5
    if e[szKey] ~= wantSize then
        e[szKey] = wantSize
        pcall(function() p.Size = Vector3.new(wantSize, wantSize, wantSize) end)
    end
    if want == "big" and target then
        pcall(function() p.CFrame = CFrame.new(target) end)   -- atomic vs Position; the ONLY per-tick write
    end
end

applyNapeFollow = function()
    restoreNapeFollow()
    Reg.start()
    local swingUntil = 0
    local accum = 0
    local swingAccum, swingAttr = 0, false        -- IsSwinging sampled at 20Hz, not per frame
    local charAccum, cChar = 99, nil              -- character ref re-resolved 2Hz
    local expanded = {}                           -- entries we drove "big", so we can drop them back
    Pins.NapeFollow = RunService.Heartbeat:Connect(function(dt)
        if not Features.NapeFollow then return end
        dt = dt or 0.016

        charAccum = charAccum + dt
        if charAccum >= 0.5 or not cChar then
            charAccum = 0
            cChar = LocalPlayer.Character
        end
        local char = cChar
        if not char then return end

        -- The cube is full-size ONLY during a swing window; the rest of the time it's tiny so your
        -- horse rides straight through it. The window opens on EITHER the M1 click (fires first,
        -- giving the cube a head start so hits don't whiff) OR IsSwinging, and holds 0.4s to cover
        -- the hit frame. ismouse1pressed() stays per-frame: it's executor-local and free.
        swingAccum = swingAccum + dt
        if swingAccum >= 0.05 then
            swingAccum = 0
            swingAttr = false
            pcall(function() if char:GetAttribute("IsSwinging") then swingAttr = true end end)
        end
        local active = swingAttr
        if not active then
            -- Don't treat M1 as a swing while the menu is OPEN: clicking/dragging the menu holds M1.
            local menuOpen = false
            pcall(function() menuOpen = (LibWindow and LibWindow:IsOpen()) and true or false end)
            if not menuOpen then
                pcall(function() if ismouse1pressed() then active = true end end)
            end
        end
        if active then swingUntil = os.clock() + 0.4 end
        local touchable = os.clock() < swingUntil

        accum = accum + dt
        if accum < 0.04 then return end            -- 25Hz ceiling
        accum = 0

        if not touchable then
            -- IDLE COSTS NOTHING. We only shrink parts WE expanded — an untouched nape is already
            -- small, so there is no reason to sweep the titan list at all. The old build re-scanned
            -- every titan in the server at 5Hz just to re-write a Size that was already correct.
            if next(expanded) ~= nil then
                for _, e in pairs(expanded) do
                    napeSetState(e, e.nape, e.napeAddr, "napeState", "napeSized", "tiny")
                    napeSetState(e, e.eye,  e.eyeAddr,  "eyeState",  "eyeSized",  "tiny")
                end
                expanded = {}
            end
            return
        end

        local myPos = Reg.myPos
        if not myPos then return end
        local range = NapeFollowRange
        local size  = math.max(20, range / 2)
        local clamp = math.max(15, range * 0.45)

        local list = Reg.tList          -- distance-sorted by the registry: nearest first
        local hit = 0
        for i = 1, #list do
            local e = list[i]
            if not e.dist or e.dist > range then break end   -- sorted, so everything after is further
            if not e.dead and e.pos then
                local delta = myPos - e.pos
                if delta.Magnitude > clamp then delta = delta.Unit * clamp end
                local target = e.pos + delta
                expanded[e.addr] = e
                napeSetState(e, e.nape, e.napeAddr, "napeState", "napeSized",
                    Features.ExtendNape and "big" or "tiny", size, target)
                napeSetState(e, e.eye, e.eyeAddr, "eyeState", "eyeSized",
                    Features.ExtendEye and "big" or "tiny", size, target)
                hit = hit + 1
                if hit >= EXPAND_MAX then break end
            end
        end
    end)
end

-- Musket Extender: ranged nape for guns/crossbows. The gun raycasts from the barrel
-- and hits the FIRST queryable part. We KILL the Eye (so it can't steal the hit) and
-- make the Nape a big cube centered on the titan body so any shot at the titan lands
-- on the nape. Confirmed working with muskets 2026-06-22.
local MUSKET_NAPE_SIZE = 80

-- Snapshot once per part so toggling OFF actually puts the titan back. Without this the nape stayed
-- Anchored=true at an 80-stud cube — and anchoring DETACHES it from the rig's welds, so it froze in
-- mid-air, invisible, on every titan we ever touched, until the round ended.
-- Keyed by ADDRESS, not the instance: a shim key misses on every later pass, so the "snapshot once"
-- guard would never trip and from tick 2 on it would record the already-modified 80-stud anchored
-- state as the "original" — re-applying exactly the bug this restore exists to prevent.
local function musketSnap(part, addr)
    local k = addr or Reg.addr(part)
    if not k or Pins.MusketOriginals[k] ~= nil then return end
    local ok, s = pcall(function()
        return { part = part, Size = part.Size, Anchored = part.Anchored,
                 CanCollide = part.CanCollide, Massless = part.Massless,
                 Transparency = part.Transparency }
    end)
    if ok and s then Pins.MusketOriginals[k] = s end
end

-- You cannot shoot what you cannot see. Beyond this there is no reason to hold a nape cube open,
-- and the registry list is distance-sorted so the sweep stops the moment it passes the limit.
local MUSKET_RANGE = 900
local MUSKET_MAX   = 12

restoreMusketExtender = function()
    if Pins.MusketExtender then Pins.MusketExtender:Disconnect(); Pins.MusketExtender = nil end
    for _, s in pairs(Pins.MusketOriginals) do
        -- CFrame is deliberately NOT restored: the titan has walked since we snapshotted, and
        -- un-anchoring lets its own weld put the nape back in the right place.
        pcall(function()
            local part = s.part
            part.Size = s.Size
            part.Transparency = s.Transparency
            part.Massless = s.Massless
            part.CanCollide = s.CanCollide
            part.Anchored = s.Anchored        -- last, so the weld reclaims it
        end)
    end
    Pins.MusketOriginals = {}
    for _, e in pairs(Reg.titans) do e.muskNape, e.muskEye = nil, nil end
end
applyMusketExtender = function()
    restoreMusketExtender()
    Reg.start()
    local musketAccum, reassert = 0, 0
    local NAPE_V3 = Vector3.new(MUSKET_NAPE_SIZE, MUSKET_NAPE_SIZE, MUSKET_NAPE_SIZE)
    local EYE_V3  = Vector3.new(0.05, 0.05, 0.05)
    Pins.MusketExtender = RunService.Heartbeat:Connect(function(dt)
        if not Features.MusketExtender then return end
        musketAccum = musketAccum + (dt or 0.016)
        if musketAccum < 0.1 then return end        -- 10Hz; the nape only has to track a walking titan
        musketAccum = 0
        -- The setup writes below are latched per titan, so if the server ever undoes one the cube
        -- would silently stop working. Drop the latches every 2s and let them be re-applied — 20x
        -- cheaper than the old unconditional re-write on every single tick.
        reassert = reassert + 1
        if reassert >= 20 then
            reassert = 0
            for _, e in pairs(Reg.titans) do e.muskNape, e.muskEye = nil, nil end
        end
        -- Everything here reads the registry cache. The old version ran FindFirstChild x3 plus two
        -- GetAttribute calls on EVERY titan in the server, 15 times a second, with no distance limit
        -- at all — about 10,000 round-trips/sec during a horde, on its own.
        local list = Reg.tList
        local done = 0
        for i = 1, #list do
            local e = list[i]
            if not e.dist or e.dist > MUSKET_RANGE then break end
            if not e.dead and e.pos then
                -- Static setup writes happen ONCE per titan, latched on the entry; only the nape's
                -- CFrame has to be re-written as the titan walks.
                if e.eye and not e.muskEye then
                    e.muskEye = true
                    musketSnap(e.eye, e.eyeAddr)
                    pcall(function() e.eye.Size = EYE_V3 end)   -- eye can't steal the ranged hit
                end
                local nape = e.nape
                if nape then
                    if not e.muskNape then
                        e.muskNape = true
                        musketSnap(nape, e.napeAddr)
                        pcall(function() nape.Anchored = true end)
                        pcall(function() nape.CanCollide = false end)
                        pcall(function() nape.Massless = true end)
                        pcall(function() nape.Size = NAPE_V3 end)
                        pcall(function() nape.Transparency = 1 end)
                    end
                    pcall(function() nape.CFrame = CFrame.new(e.pos) end)
                end
                done = done + 1
                if done >= MUSKET_MAX then break end
            end
        end
    end)
end

restoreNoFallDamage = function()
    if Pins.NoFallDamage then Pins.NoFallDamage:Disconnect(); Pins.NoFallDamage = nil end
    pcall(function() local c = LocalPlayer.Character; if c then c:SetAttribute("FallDamageImmune", false) end end)
end
applyNoFallDamage = function()
    restoreNoFallDamage()
    -- Pin FallDamageImmune=true on our character (~5Hz). CharacterLoader applies fall damage only
    -- when this attribute is FALSE (the game's own OdmClass sets it true while hooking), so pinning
    -- it true = no fall damage. One cheap attribute; 5Hz to beat the game's 0.25s reset-to-false.
    local accum = 0
    Pins.NoFallDamage = RunService.Heartbeat:Connect(function(dt)
        accum = accum + (dt or 0.016)
        if accum < 0.2 then return end
        accum = 0
        local c = LocalPlayer.Character
        if c then pcall(function() c:SetAttribute("FallDamageImmune", true) end) end
    end)
end
restoreCanRollUnlock = function()
    if Pins.CanRoll then Pins.CanRoll:Disconnect(); Pins.CanRoll = nil end
    -- Don't try to flip them back — that would lock you out of working talents
    Pins.CanRollList = {}
end
applyCanRollUnlock = function()
    restoreCanRollUnlock()
    -- Build the list of currently-locked talent modules
    local rs = game:GetService("ReplicatedStorage")
    local lib = rs:FindFirstChild("ReplicatedAssets")
    if not lib then return end
    lib = lib:FindFirstChild("AllTalents")
    if not lib then return end

    for _, m in ipairs(lib:GetDescendants()) do
        if m:IsA("ModuleScript") then
            local cr
            pcall(function() cr = m:GetAttribute("CanRoll") end)
            if cr == false then
                table.insert(Pins.CanRollList, m)
                pcall(function() m:SetAttribute("CanRoll", true) end)
            end
        end
    end
    -- Persistent pin
    -- Throttled to 2Hz: this was unthrottled, writing one attribute per talent module (dozens) on
    -- EVERY Heartbeat = thousands of bridge round-trips/sec. It is reachable from a persisted
    -- config, so anyone carrying canRollUnlock=true was paying that on every load. CanRoll is only
    -- read when the talent-roll UI evaluates, so 2Hz is ample.
    local accum = 0
    Pins.CanRoll = RunService.Heartbeat:Connect(function(dt)
        accum = accum + (dt or 0.016)
        if accum < 0.5 then return end
        accum = 0
        for _, m in ipairs(Pins.CanRollList) do
            pcall(function() m:SetAttribute("CanRoll", true) end)
        end
    end)
end


-- ============================================================
-- MATCHA ESP ENGINE — a pure renderer over the world registry
-- ============================================================
-- This block no longer touches the game tree AT ALL. Reg samples positions/attributes on its own
-- slow loop; here we only smooth, project, and write Drawing properties (Matcha-local, no bridge).
--
-- What made the old renderer unusable in a full server or a horde — it ran at 144Hz and, EVERY
-- FRAME, per object:
--   * players: model.Parent, hrp.Parent, hrp.Position + TWO WorldToScreen  (~5 round-trips)
--   * titans:  the same, plus GetAttribute("NapeHealth"), GetAttribute("Dead"), and for the nape
--              marker FindFirstChild("DamagePoints") + FindFirstChild("Nape") + .Position
--              (~11 round-trips — that marker alone was ~5,000 FindFirstChild/sec)
--   * plus Workspace.CurrentCamera.ViewportSize re-read every single frame
-- 30 players + 40 titans came to roughly 45,000-80,000 round-trips/sec, against a bridge that
-- serves a few thousand. The bridge saturated, so every menu click queued behind the backlog —
-- which is why the INTERFACE froze even though the menu itself is cheap.
--
-- Now:
--   * all game data comes from the registry cache — zero tree access in the render path
--   * ONE WorldToScreen per drawn object. The box height comes from the camera's own projection
--     maths (boxH = span * ppK / dist, ppK = (vpH/2)/tan(fov/2)) — which is precisely what
--     projecting a second world point was measuring, for double the cost.
--   * 60Hz, because samples arrive at Reg.HZ (15Hz) and are eased between frames; a higher render
--     rate bought nothing but traffic.
--   * the render caps ALWAYS apply, and Reg.tList is already distance-sorted, so the nearest-N cull
--     is just an index compare — the old markPlayerCull/markTitanCull ranking passes (2 reads per
--     object, twice a second, on top of everything else) are gone entirely.

do

local ESP_RENDER_HZ = 60
local ESP_SMOOTH_K  = 22          -- exp-smoothing stiffness (frame-rate independent; higher = snappier)
local V2, V3 = Vector2.new, Vector3.new
local floor, expf, minf, maxf = math.floor, math.exp, math.min, math.max

-- Foot-to-head span in studs, centred on the HumanoidRootPart. The old code projected pos+(0,3,0)
-- and pos-(0,3,0) for players and pos+(0,9,0)/pos-(0,9,0) for titans — same 6 and 18 studs.
local PLAYER_SPAN = 6
local TITAN_SPAN  = 18

local TITAN_ESP = {
    Color        = Color3.fromRGB(255, 120, 40),
    NapeColor    = Color3.fromRGB(255, 60, 60),
    MaxDistance  = 100000,
    MaxRender    = 18,   -- normal cap
    StrictRender = 8,    -- Features.TitanCap ("Cap (horde perf)") tightens to this
    NapeMax      = 8,    -- only the closest few get the nape marker's extra projection
}

-- Viewport + field of view, re-read once a second instead of every frame. ppK converts a world
-- height into pixels at 1 stud: screenHeight = worldHeight * ppK / distance.
local vpW, vpH, ppK, vpAt = 1920, 1080, 900, 0
local function updView(nowc)
    if nowc - vpAt < 1 then return end
    vpAt = nowc
    pcall(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        if vp then vpW, vpH = vp.X, vp.Y end
        local fov = tonumber(cam.FieldOfView)
        if fov and fov > 1 and fov < 170 then
            ppK = (vpH * 0.5) / math.tan(fov * math.pi / 360)
        end
    end)
end

local function roundPx(n) return floor((n or 0) + 0.5) end
local function rv2(x, y) return V2(roundPx(x), roundPx(y)) end

local function project(pos)
    local ok, screen, onScreen = pcall(WorldToScreen, pos)
    if ok then return screen, onScreen end
    return nil, false
end

-- On-screen height of a world-vertical span, recovered from ONE projected point.
-- Perspective scaling depends on DEPTH along the view axis, but the registry only gives us radial
-- distance. They differ by cos(angle-off-centre), which we can read straight off the projection:
-- the point's offset from screen centre, in units of ppK, IS tan of that angle per axis. So
--   depth = dist / sqrt(1 + tx^2 + ty^2)   and   heightPx = span * ppK / depth
-- Skipping this would draw targets near the screen edge up to ~35% too small at a 70 degree FOV.
local function spanPx(span, dist, sx, sy)
    local tx = (sx - vpW * 0.5) / ppK
    local ty = (sy - vpH * 0.5) / ppK
    return span * ppK * math.sqrt(1 + tx * tx + ty * ty) / dist
end

-- ---------- Drawing bundles (one per registry entry, created lazily, hidden not removed) ----------

local function mkText(size, z)
    local t = Drawing.new("Text")
    t.Size = size; t.Center = true; t.Outline = true; t.Font = Drawing.Fonts.System
    t.Visible = false; t.ZIndex = z
    return t
end
local function mkSquare(z, filled)
    local s = Drawing.new("Square")
    s.Thickness = 1; s.Filled = filled and true or false
    s.Visible = false; s.ZIndex = z
    return s
end

local function makeBundle(isTitan)
    local ok, b = pcall(function()
        local t = {
            box    = mkSquare(2, false),
            name   = mkText(13, 3),
            hpFill = mkSquare(2, true),
            hpNum  = mkText(12, 3),
        }
        if isTitan then
            local c = Drawing.new("Circle")
            c.Thickness = 2; c.Filled = false; c.NumSides = 14; c.Radius = 5
            c.Color = TITAN_ESP.NapeColor; c.Visible = false; c.ZIndex = 3
            t.nape = c
        else
            t.dist = mkText(12, 3)
            local l = Drawing.new("Line")
            l.Thickness = 1; l.Visible = false; l.ZIndex = 1
            t.tracer = l
        end
        t.cache = {}
        return t
    end)
    return ok and b or nil
end

local function freeBundle(b)
    if not b then return end
    for k, el in pairs(b) do
        if k ~= "cache" then pcall(function() el:Remove() end) end
    end
end

local function hideBundle(b)
    if not b or b.cache.hidden then return end
    for k, el in pairs(b) do
        if k ~= "cache" then pcall(function() el.Visible = false end) end
    end
    -- Fresh cache: the next show must re-write visibility AND text, since we just invalidated both.
    b.cache = { hidden = true }
end

local function setVis(b, el, key, want)
    if b.cache[key] ~= want then
        b.cache[key] = want
        el.Visible = want
    end
end

local function freeAll()
    for _, e in pairs(Reg.titans)  do if e.esp then freeBundle(e.esp); e.esp = nil end end
    for _, e in pairs(Reg.players) do if e.esp then freeBundle(e.esp); e.esp = nil end end
end

-- The registry calls this when a model leaves the world, so its Drawing objects go with it.
Reg.onDrop = function(e)
    if e.esp then freeBundle(e.esp); e.esp = nil end
end

-- Ease the registry's low-rate sample into smooth on-screen motion. Scalar components, so no
-- Vector3 allocation per frame (the old per-frame :Lerp was a real GC/stutter source); snaps on
-- big jumps so it never trails across the map after a respawn or teleport.
local function smoothPos(e, pos, dt)
    local sx, sy, sz = e.sx, e.sy, e.sz
    if sx then
        local jx, jy, jz = pos.X - sx, pos.Y - sy, pos.Z - sz
        if jx * jx + jy * jy + jz * jz > 1600 then      -- >40 studs → snap
            sx, sy, sz = pos.X, pos.Y, pos.Z
        else
            local a = 1 - expf(-ESP_SMOOTH_K * dt)
            sx, sy, sz = sx + jx * a, sy + jy * a, sz + jz * a
        end
    else
        sx, sy, sz = pos.X, pos.Y, pos.Z
    end
    e.sx, e.sy, e.sz = sx, sy, sz
    return sx, sy, sz
end

-- ---------- players ----------

local function drawPlayer(e, dt, col, colVer)
    local pos = e.pos
    if not pos then return false end
    local dist = e.dist
    if dist and dist > PLAYER_ESP.MaxDistance then return false end

    local sx, sy, sz = smoothPos(e, pos, dt)
    local s, on = project(V3(sx, sy, sz))
    if not (s and on) then return false end

    local b = e.esp
    if not b then
        b = makeBundle(false)
        e.esp = b
        if not b then return false end
    end
    b.cache.hidden = nil

    if b.cache.colVer ~= colVer then
        b.cache.colVer = colVer
        b.box.Color = col
        b.name.Color = col
        b.dist.Color = col
        b.tracer.Color = col
    end

    local d = dist or 100
    if d < 1 then d = 1 end
    local boxH = maxf(6, spanPx(PLAYER_SPAN, d, s.X, s.Y))
    local boxW = boxH * 0.42
    local cx = s.X
    local topY = s.Y - boxH * 0.5
    local bottomY = s.Y + boxH * 0.5
    local boxX = cx - boxW * 0.5

    if PLAYER_ESP.ShowBox then
        b.box.Position = rv2(boxX, topY)
        b.box.Size = rv2(boxW, boxH)
        setVis(b, b.box, "boxVis", true)
    else
        setVis(b, b.box, "boxVis", false)
    end

    local nameStr = PLAYER_ESP.ShowName and (e.displayName or e.name) or ""
    if nameStr ~= "" then
        b.name.Position = rv2(cx, topY - 16)
        if b.cache.nameTxt ~= nameStr then
            b.cache.nameTxt = nameStr
            b.name.Text = nameStr
        end
        setVis(b, b.name, "nameVis", true)
    else
        setVis(b, b.name, "nameVis", false)
    end

    local showHp = PLAYER_ESP.ShowHealthBar and e.hpPct ~= nil
    if showHp then
        local barW = 3
        local fillH = boxH * e.hpPct
        b.hpFill.Position = rv2(boxX - barW - 3, topY + (boxH - fillH))
        b.hpFill.Size = rv2(barW, fillH)
        b.hpFill.Color = e.hpColor
        setVis(b, b.hpFill, "hpFillVis", true)
    else
        setVis(b, b.hpFill, "hpFillVis", false)
    end

    local belowY = bottomY + 1
    local distInt = (PLAYER_ESP.ShowDistance and dist) and floor(dist + 0.5) or nil
    if distInt then
        b.dist.Position = rv2(cx, belowY)
        if b.cache.distInt ~= distInt then   -- build the string only when the integer changes
            b.cache.distInt = distInt
            b.dist.Text = distInt .. "m"
        end
        setVis(b, b.dist, "distVis", true)
        belowY = belowY + 13
    else
        setVis(b, b.dist, "distVis", false)
    end

    if showHp then
        b.hpNum.Position = rv2(cx, belowY)
        local hpStr = e.hpStr or "?"
        if b.cache.hpNumTxt ~= hpStr then
            b.cache.hpNumTxt = hpStr
            b.hpNum.Text = hpStr
        end
        b.hpNum.Color = e.hpColor
        setVis(b, b.hpNum, "hpNumVis", true)
    else
        setVis(b, b.hpNum, "hpNumVis", false)
    end

    if PLAYER_ESP.ShowTracer then
        b.tracer.From = rv2(vpW * 0.5, vpH)
        b.tracer.To = rv2(cx, bottomY)
        setVis(b, b.tracer, "tracerVis", true)
    else
        setVis(b, b.tracer, "tracerVis", false)
    end
    return true
end

local function espUpdate(dt)
    local list = Reg.pList
    if not Features.PlayerESP then
        for i = 1, #list do
            local e = list[i]
            if e.esp then hideBundle(e.esp) end
        end
        return
    end
    local col = PLAYER_ESP.Color
    local colVer = PLAYER_ESP._colVer or 0
    local cap = PLAYER_ESP.MaxRender or 16
    for i = 1, #list do
        local e = list[i]
        -- Reg.pList is distance-sorted, so "index > cap" IS the nearest-N cull. No ranking pass.
        if i <= cap then
            local ok, shown = pcall(drawPlayer, e, dt, col, colVer)
            if not (ok and shown) then if e.esp then hideBundle(e.esp) end end
        elseif e.esp then
            hideBundle(e.esp)
        end
    end
end

-- ---------- titans ----------

local function drawTitan(e, dt, rank)
    local pos = e.pos
    if not pos then return false end
    if e.dead then return false end     -- corpse: the game leaves it in the folder at NapeHealth<=0
    local dist = e.dist
    if dist and dist > TITAN_ESP.MaxDistance then return false end

    local sx, sy, sz = smoothPos(e, pos, dt)
    local s, on = project(V3(sx, sy, sz))
    if not (s and on) then return false end

    local b = e.esp
    if not b then
        b = makeBundle(true)
        e.esp = b
        if not b then return false end
    end
    b.cache.hidden = nil

    local d = dist or 100
    if d < 1 then d = 1 end
    local boxH = maxf(8, spanPx(TITAN_SPAN, d, s.X, s.Y))
    local boxW = boxH * 0.50
    local cx = s.X
    local topY = s.Y - boxH * 0.5
    local bottomY = s.Y + boxH * 0.5
    local boxX = cx - boxW * 0.5

    -- "Nape HP Only" declutter mode: drop the box, label, HP bar and marker, leaving just the
    -- number. Costs LESS than normal mode — setVis writes .Visible once on the transition, then
    -- these branches skip their Position/Size/Text writes entirely.
    local hpOnly = Features.TitanHPOnly

    if hpOnly then
        setVis(b, b.box, "boxVis", false)
        setVis(b, b.name, "nameVis", false)
    else
        b.box.Position = rv2(boxX, topY)
        b.box.Size = rv2(boxW, boxH)
        if b.cache.tColor ~= 1 then b.cache.tColor = 1; b.box.Color = TITAN_ESP.Color; b.name.Color = TITAN_ESP.Color end
        setVis(b, b.box, "boxVis", true)

        local distInt = dist and floor(dist + 0.5) or nil
        if b.cache.distInt ~= distInt then
            b.cache.distInt = distInt
            b.name.Text = "Titan" .. (distInt and ("  " .. distInt .. "m") or "")
        end
        b.name.Position = rv2(cx, topY - 16)
        setVis(b, b.name, "nameVis", true)
    end

    if e.napePct then
        if hpOnly then
            setVis(b, b.hpFill, "hpFillVis", false)
        else
            local barW = 3
            local fillH = boxH * e.napePct
            b.hpFill.Position = rv2(boxX - barW - 3, topY + (boxH - fillH))
            b.hpFill.Size = rv2(barW, fillH)
            b.hpFill.Color = e.napeColor
            setVis(b, b.hpFill, "hpFillVis", true)
        end
        -- HP-only puts the number at mid-body (nothing else is drawn to anchor it to)
        b.hpNum.Position = hpOnly and rv2(cx, s.Y) or rv2(cx, bottomY + 1)
        b.hpNum.Color = e.napeColor
        if b.cache.hpNumTxt ~= e.napeTxt then
            b.cache.hpNumTxt = e.napeTxt
            b.hpNum.Text = e.napeTxt
        end
        setVis(b, b.hpNum, "hpNumVis", true)
    else
        setVis(b, b.hpFill, "hpFillVis", false)
        setVis(b, b.hpNum, "hpNumVis", false)
    end

    -- The marker costs a SECOND projection, so only the closest few get one — you can only aim at
    -- one titan anyway. The nape's world position is sampled by the registry (and skipped there
    -- entirely when the expander owns the nape, since it moves it to you).
    if b.nape then
        if Features.TitanNapeMarker and not hpOnly and rank <= TITAN_ESP.NapeMax then
            local ns, onN = project(e.napePos or (pos + V3(0, 5, 0)))
            if ns and onN then
                b.nape.Position = rv2(ns.X, ns.Y)
                b.nape.Radius = dist and maxf(3, minf(11, 700 / maxf(1, dist))) or 6
                setVis(b, b.nape, "napeVis", true)
            else
                setVis(b, b.nape, "napeVis", false)
            end
        else
            setVis(b, b.nape, "napeVis", false)
        end
    end
    return true
end

local function titanEspUpdate(dt)
    local list = Reg.tList
    if not Features.TitanESP then
        for i = 1, #list do
            local e = list[i]
            if e.esp then hideBundle(e.esp) end
        end
        return
    end
    local cap = Features.TitanCap and TITAN_ESP.StrictRender or TITAN_ESP.MaxRender
    for i = 1, #list do
        local e = list[i]
        if i <= cap then
            local ok, shown = pcall(drawTitan, e, dt, i)
            if not (ok and shown) then if e.esp then hideBundle(e.esp) end end
        elseif e.esp then
            hideBundle(e.esp)
        end
    end
end

-- ---------- lifecycle ----------

GUI.StopEspLoops = function()
    local state = _G.__VERFALL_MATCHA_ESP
    if state then state.stop = true end
    _G.__VERFALL_MATCHA_ESP = nil
    freeAll()
end

GUI.StartEspLoops = function()
    local old = _G.__VERFALL_MATCHA_ESP
    if old then old.stop = true end
    freeAll()
    Reg.start()                       -- discovery + sampling live in the registry now

    local state = { stop = false }
    _G.__VERFALL_MATCHA_ESP = state

    task.spawn(function()
        local fastIv, slowIv = 1 / ESP_RENDER_HZ, 1 / 25
        local iv, ema = fastIv, 0
        local last = os.clock()
        while GUI.Running and _G.__VERFALL_MATCHA_ESP == state and not state.stop do
            local now = os.clock()
            local dt = now - last
            last = now
            if dt > 0.25 then dt = 0.25 end     -- a long stall must not blow the smoothing up
            updView(now)

            local t0 = os.clock()
            pcall(espUpdate, dt)
            pcall(titanEspUpdate, dt)
            local cost = os.clock() - t0

            -- ADAPTIVE PACING. Matcha's per-call costs vary by build and by how busy the game
            -- thread is, and the bridge poll runs INLINE on that same thread — so an ESP pass that
            -- overruns doesn't just drop ESP frames, it starves the menu. Rather than trust a fixed
            -- rate, measure the pass and keep it under ~35% of the frame budget: stretch toward
            -- 25Hz when a horde makes it expensive, walk back to 60Hz when it's cheap. This is what
            -- makes the menu stay responsive in the worst case instead of collapsing.
            ema = ema * 0.9 + cost * 0.1
            local target = ema / 0.35
            if target < fastIv then target = fastIv elseif target > slowIv then target = slowIv end
            iv = iv + (target - iv) * 0.2

            -- Idle cheaply when nothing is being drawn, instead of spinning over two empty lists.
            task.wait((Features.PlayerESP or Features.TitanESP) and iv or 0.2)
        end
    end)
end

end

