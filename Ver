-- Horse "Never Stops" and "Running With Sword" were removed 2026-06-15 for performance; re-ported
-- 2026-07-30 from the old build, but THROTTLED. The originals ran every Heartbeat: Never Stops
-- re-resolved the horse (3+ FindFirstChild round-trips) and read AssemblyLinearVelocity 60-144x/sec,
-- and Running With Sword wrote 2 attributes ~33x/sec whether or not you were swinging. Both are the
-- kind of per-frame bridge traffic that froze the old menu.

-- NEVER STOPS — keeps the horse from stalling. Two halves on one 10Hz timer:
--   (a) re-pin MaxSpeed/Stamina so the game can't quietly zero them mid-ride
--   (b) momentum: remember the last good heading and, if the horse has nearly stopped, push it back
--       up to speed along that heading
-- The horse and its root part are cached and only re-resolved every 2s (or when the ref dies).
restoreNeverStops = function()
    if Pins.NeverStops then Pins.NeverStops:Disconnect(); Pins.NeverStops = nil end
    -- Undo the attribute half. We share Horse.Orig/SnapTaken with Infinite Stamina, so only put the
    -- horse back if THAT feature isn't the one holding the boost (otherwise we'd fight it).
    if not Features.HorseBoost then pcall(restoreHorse) end
end
applyNeverStops = function()
    restoreNeverStops()
    local accum, reAccum = 0, 99          -- 99 => resolve on the very first tick, then every 2s
    local horse, root, lastDir, lastMoveAt
    Pins.NeverStops = RunService.Heartbeat:Connect(function(dt)
        if not Features.NeverStops then return end     -- cheapest guard first
        -- THROTTLE FIRST. The horse re-resolve below is 3+ bridge round-trips; running it above this
        -- gate meant findHorse() fired on EVERY Heartbeat while you were unmounted (~570/sec), which
        -- is the exact freeze pattern this file exists to avoid.
        accum = accum + (dt or 0.016)
        if accum < 0.1 then return end                  -- 10Hz
        accum = 0

        -- Re-resolve on a 2s cadence, or immediately if the cached root died. Note the cooldown is
        -- honoured even while UNMOUNTED (horse == nil), so standing around costs ~1 lookup / 2s
        -- rather than one per tick.
        reAccum = reAccum + 0.1
        if reAccum >= 2 or (root and not root.Parent) then
            reAccum = 0
            horse = findHorse()
            root = nil
            lastDir = nil     -- drop the stale heading: re-resolving means a different/absent horse
            if horse then
                local ok, r = pcall(function()
                    return horse.PrimaryPart or horse:FindFirstChild("HumanoidRootPart")
                        or horse:FindFirstChild("Torso")
                end)
                root = ok and r or nil
            end
        end
        if not (horse and root) then return end

        -- Snapshot BEFORE the first write, reusing Infinite Stamina's slot, so restoreHorse can put
        -- the real values back. Without this, enabling Never Stops alone left the horse permanently
        -- boosted (restoreHorse early-returns unless SnapTaken) and a later Infinite Stamina toggle
        -- would snapshot our own modified value as the "original".
        if not Horse.SnapTaken then
            Horse.Orig = {
                MaxStamina = num(horse:GetAttribute("MaxStamina"), 600),
                RegenRate  = num(horse:GetAttribute("RegenRate"), 50),
                MaxSpeed   = num(horse:GetAttribute("MaxSpeed"), 65),
            }
            Horse.SnapTaken = true
        end

        pcall(function() horse:SetAttribute("MaxSpeed", Horse.MaxSpeed) end)
        pcall(function() horse:SetAttribute("Stamina",  HORSE_MAX_STAMINA) end)
        local ok, vel = pcall(function() return root.AssemblyLinearVelocity end)
        if not ok or not vel then return end
        local flatX, flatZ = vel.X, vel.Z
        local mag = math.sqrt(flatX * flatX + flatZ * flatZ)
        if mag > 8 then
            lastDir = { x = flatX / mag, z = flatZ / mag }   -- moving: remember the heading
            lastMoveAt = os.clock()
        elseif lastDir and (os.clock() - (lastMoveAt or 0)) < 1.5 then
            -- Stalled while we had a RECENT heading -> shove it back up to speed.
            -- The 1.5s window matters: findHorse resolves your horse BY NAME, not by who is riding
            -- it, so without it a horse you dismounted would keep getting pushed and run off on its
            -- own. A real stall is resolved within a moment; parking for longer than that stops.
            local sp = Horse.MaxSpeed or 65
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.new(lastDir.x * sp, vel.Y, lastDir.z * sp)
            end)
        end
    end)
end

-- RUNNING WITH SWORD — really "don't get movement-locked while swinging". The swing sets
-- Character.DisableDirectionalMovement = true to freeze your movement for its duration; pinning it
-- false keeps full run speed through the swing. 5Hz (2 writes per 0.2s) instead of the old ~33Hz.
restoreRunWithSword = function()
    if Pins.RunWithSword then Pins.RunWithSword:Disconnect(); Pins.RunWithSword = nil end
    -- DisableDirectionalMovement self-heals (the game re-asserts it on the next swing), but nothing
    -- ever clears HandlesOut, so we must — otherwise the character is stuck weapon-drawn with the
    -- toggle showing OFF.
    local char = LocalPlayer.Character
    if char then pcall(function() char:SetAttribute("HandlesOut", false) end) end
end
applyRunWithSword = function()
    restoreRunWithSword()
    local accum = 0
    Pins.RunWithSword = RunService.Heartbeat:Connect(function(dt)
        if not Features.RunWithSword then return end
        accum = accum + (dt or 0.016)
        if accum < 0.2 then return end                  -- 5Hz
        accum = 0
        local char = LocalPlayer.Character
        if not char then return end
        pcall(function() char:SetAttribute("DisableDirectionalMovement", false) end)
        pcall(function() char:SetAttribute("HandlesOut", true) end)
    end)
end

-- VELO HUD — bottom-centre readout of your live ODM velocity: CURRENT (colour-graded), PEAK, and a
-- meter bar filling toward 500. Ported 2026-07-30. Runs on its OWN 12Hz task.spawn loop rather than
-- the 144Hz ESP render loop — a speed number redrawn 144x/sec is unreadable and costs a velocity
-- read every frame. Drawing objects are built once and reused; the Text strings are only rebuilt
-- when the displayed integer actually changes (same cache-the-string trick the ESP uses).
local VeloHUD = { gen = 0, o = nil, peak = 0, lastCur = nil, lastPeak = nil }

local function veloHudDestroy()
    local o = VeloHUD.o
    if not o then return end
    for _, el in pairs(o) do pcall(function() el:Remove() end) end
    VeloHUD.o = nil
end

restoreVeloHUD = function()
    VeloHUD.gen = VeloHUD.gen + 1     -- invalidate any running loop
    veloHudDestroy()
    VeloHUD.peak = 0
    VeloHUD.lastCur, VeloHUD.lastPeak = nil, nil
end

applyVeloHUD = function()
    restoreVeloHUD()
    VeloHUD.gen = VeloHUD.gen + 1
    local myGen = VeloHUD.gen

    local function mk(kind, z)
        local ok, el = pcall(Drawing.new, kind)
        if not ok or not el then return nil end
        el.Visible = false
        el.ZIndex = z
        return el
    end
    local o = {
        bg   = mk("Square", 90),
        bar  = mk("Square", 92),
        fill = mk("Square", 93),
        cur  = mk("Text", 94),
        peak = mk("Text", 94),
        tag  = mk("Text", 94),
    }
    if not (o.bg and o.bar and o.fill and o.cur and o.peak and o.tag) then
        for _, el in pairs(o) do pcall(function() el:Remove() end) end
        return
    end
    o.bg.Filled = true;   o.bg.Color = Color3.fromRGB(14, 14, 18);  o.bg.Transparency = 0.82
    o.bar.Filled = true;  o.bar.Color = Color3.fromRGB(32, 32, 40)
    o.fill.Filled = true; o.fill.Color = Color3.fromRGB(90, 180, 255)
    for _, t in ipairs({ o.cur, o.peak, o.tag }) do
        t.Center = true; t.Outline = false; t.Font = Drawing.Fonts.SystemBold
    end
    o.cur.Size = 26; o.peak.Size = 13; o.tag.Size = 11
    o.cur.Color = Color3.fromRGB(235, 235, 240)
    o.peak.Color = Color3.fromRGB(100, 176, 255)
    o.tag.Color = Color3.fromRGB(130, 130, 145)
    o.tag.Text = "VELOCITY"          -- constant: set once here, never in the loop
    VeloHUD.o = o
    local shown, lastBand = false, nil

    task.spawn(function()
        local vpW, vpH, vpAccum = 1920, 1080, 99
        while VeloHUD.gen == myGen and GUI.Running do
            if not Features.VeloHUD then break end
            -- viewport only changes on a resize -> re-read every ~2s, not every tick
            vpAccum = vpAccum + 1
            if vpAccum >= 24 then
                vpAccum = 0
                pcall(function()
                    local cam = Workspace.CurrentCamera        -- capital-W local, like the rest of the file
                    local vp = cam and cam.ViewportSize
                    if vp then vpW, vpH = vp.X, vp.Y end
                end)
            end

            local speed = 0
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local v = hrp.AssemblyLinearVelocity
                    speed = math.sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z)
                end
            end)
            if speed > VeloHUD.peak then VeloHUD.peak = speed end

            local w, h = 210, 62
            local x, y = (vpW - w) * 0.5, vpH - h - 70
            o.bg.Position = Vector2.new(x, y);            o.bg.Size = Vector2.new(w, h)
            o.bar.Position = Vector2.new(x + 14, y + h - 14); o.bar.Size = Vector2.new(w - 28, 5)
            local pct = math.max(0, math.min(1, speed / 500))
            o.fill.Position = Vector2.new(x + 14, y + h - 14)
            o.fill.Size = Vector2.new(math.max(1, (w - 28) * pct), 5)

            local curI = math.floor(speed + 0.5)
            local walking = speed < 50            -- below 50 you're on foot, not grappling
            -- Cache the RENDERED STRING, not curI: the text depends on `walking` too, and both 49.7
            -- and 50.2 floor to 50 — keying on the integer alone would leave "walking" on screen
            -- after you crossed the threshold (while the colour band correctly flipped).
            local curTxt = walking and "walking" or tostring(curI)
            if VeloHUD.lastCur ~= curTxt then
                VeloHUD.lastCur = curTxt
                o.cur.Text = curTxt
            end
            -- recolour only when the speed band actually changes, not every tick
            local band = walking and 0 or (speed >= 300 and 3 or (speed >= 180 and 2 or 1))
            if lastBand ~= band then
                lastBand = band
                o.cur.Color = (band == 0 and Color3.fromRGB(120, 120, 132))
                    or (band == 3 and Color3.fromRGB(255, 90, 90))
                    or (band == 2 and Color3.fromRGB(245, 200, 72))
                    or Color3.fromRGB(235, 235, 240)
            end
            o.cur.Position = Vector2.new(x + w * 0.5, y + 10)

            local peakI = math.floor(VeloHUD.peak + 0.5)
            if VeloHUD.lastPeak ~= peakI then
                VeloHUD.lastPeak = peakI
                o.peak.Text = "peak " .. peakI
            end
            o.peak.Position = Vector2.new(x + w * 0.5, y + 38)
            o.tag.Position = Vector2.new(x + w * 0.5, y - 2)

            if not shown then                        -- .Visible never changes after the first tick
                shown = true
                for _, el in pairs(o) do el.Visible = true end
            end
            task.wait(1 / 12)
        end
        if VeloHUD.gen == myGen then veloHudDestroy() end
    end)
end

-- ============================================================
-- BUFFS — ClientInformation attribute pins
-- HookRange = 1000 : extended grapple distance (confirmed working)
-- GasConservation = 1000 (server clamps to ~2) : slower gas drain (confirmed working)
-- CanRollUnlock : flip CanRoll=true on locked talent categories (Lore/Holy/Unique/etc.)
-- ============================================================

-- Buff target values now live in BuffsState[key].target (user-editable via UI)

local function makeAttrPin(attrName, key)
    -- NOTE: this per-buff pin is superseded by Auto Pin (one timer for all 9 buffs) and currently has
    -- no callers — applyHookRange/GasConservation/ReloadSpeed/OdmVeloCap/RunSpeed are orphaned, though
    -- their restore* partners are still invoked by resetConfig/UnloadScript, so the pair stays.
    -- It is throttled anyway: unthrottled it was 2 bridge round-trips per frame PER BUFF (~600/sec),
    -- and leaving that armed for whoever re-wires it later is exactly the landmine this file removed.
    local accum = 0
    return RunService.Heartbeat:Connect(function(dt)
        accum = accum + (dt or 0.016)
        if accum < 0.5 then return end
        accum = 0
        local ci = LocalPlayer:FindFirstChild("ClientInformation")
        if not ci then return end
        local b = BuffsState[key]
        if not b then return end
        pcall(function() ci:SetAttribute(attrName, b.target) end)
    end)
end

restoreHookRange = function()
    if Pins.Hook then Pins.Hook:Disconnect(); Pins.Hook = nil end
